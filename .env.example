# 通常は `uv run duo-checker` の初回セットアップが .env を自動で作るので、このファイルは不要です。
# 手で設定したい場合は .env にコピーして `chmod 600 .env` してください。環境変数でも指定できます。

# 送信に使うアカウント（Gmail / iCloud / Yahoo!メールはサーバー設定を自動判定）
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# 通知先（省略時は SMTP_USER 宛て。カンマ区切りで複数可）
MAIL_TO=you@gmail.com

# 上記以外のメールサービスの場合のみ
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls       # starttls / ssl / none
# MAIL_FROM=you@example.com

# 任意設定
# DUO_STORES=R005,R718         # 監視する店舗番号。未指定なら全国の全店舗
# DUO_INTERVAL_SECONDS=30      # 確認間隔（秒、30 以上）
# DUO_ERROR_ALERT_MINUTES=10   # 在庫を取得できない状態がこの分数続いたら警告メール
# DUO_MAC_NOTIFICATION=1       # メールに加えて Mac の通知センターにも表示する
# DUO_API_MODE=auto            # auto / pickup / fulfillment
# DUO_TRANSPORT=auto           # auto / http / safari / curl_cffi
# DUO_CURL_IMPERSONATE=chrome  # chrome または chrome124 のような固定版
# DUO_REQUEST_TIMEOUT_SECONDS=25
# DUO_541_COOLDOWN_SECONDS=120 # 541後はこの秒数、通信せず冷却する
